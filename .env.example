# API key de Giphy (https://developers.giphy.com/dashboard/)
# Necesaria para buscar GIFs de avatar. Sin key: solo avatares clásicos.
VITE_GIPHY_API_KEY=

# Supabase (https://supabase.com/dashboard → Project Settings → API)
# Sin estas keys la app sigue 100% local (Dexie), como ahora.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
